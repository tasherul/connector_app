<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic dark-navy surfaces and text. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111D2F" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#17243A" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#17243A" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#17243A" />
    <SolidColorBrush x:Key="CardBrush" Color="#17243A" />
    <SolidColorBrush x:Key="TerminalBrush" Color="#08111F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3B4B63" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />

    <!-- Status colors are also consumed by the dashboard signal converter. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8" />

    <!-- Explicit interactive-state colors avoid relying on system inheritance. -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E1A2B" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#526581" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#263247" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#B6C2D3" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#526176" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="ValidationTextBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="ValidationBackgroundBrush" Color="#3A1B27" />
    <SolidColorBrush x:Key="ValidationBorderBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="OutlinedButtonBackgroundBrush" Color="#111D2F" />
    <SolidColorBrush x:Key="OutlinedButtonHoverBrush" Color="#223752" />
    <SolidColorBrush x:Key="OutlinedButtonBorderBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="NeutralButtonBackgroundBrush" Color="#111D2F" />
    <SolidColorBrush x:Key="NeutralButtonHoverBrush" Color="#223752" />
    <SolidColorBrush x:Key="NeutralButtonPressedBrush" Color="#2A405C" />
    <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#64748B" />
    <SolidColorBrush x:Key="InfoOutlineBackgroundBrush" Color="#111D2F" />
    <SolidColorBrush x:Key="InfoOutlineHoverBrush" Color="#173B55" />
    <SolidColorBrush x:Key="InfoOutlinePressedBrush" Color="#1E4763" />
    <SolidColorBrush x:Key="InfoOutlineTextBrush" Color="#BAE6FD" />
    <SolidColorBrush x:Key="InfoOutlineBorderBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="DangerOutlineBackgroundBrush" Color="#111D2F" />
    <SolidColorBrush x:Key="DangerOutlineHoverBrush" Color="#3A1B27" />
    <SolidColorBrush x:Key="DangerOutlinePressedBrush" Color="#4C1725" />
    <SolidColorBrush x:Key="DangerOutlineTextBrush" Color="#FDA4AF" />
    <SolidColorBrush x:Key="DangerOutlineBorderBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="DangerButtonPressedBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="SuccessButtonBackgroundBrush" Color="#166534" />
    <SolidColorBrush x:Key="SuccessButtonHoverBrush" Color="#14532D" />
    <SolidColorBrush x:Key="SuccessButtonPressedBrush" Color="#0F3D22" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#07111F" />
    <SolidColorBrush x:Key="OnSuccessTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OnDangerTextBrush" Color="#FFF7F7" />

    <!-- The activity feed keeps muted tinted, but still opaque, category surfaces. -->
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#243D2F" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#453619" />
    <SolidColorBrush x:Key="LogActionBrush" Color="#173B55" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#4A2027" />
    <SolidColorBrush x:Key="LogGeneralBrush" Color="#111C2E" />
</ResourceDictionary>
