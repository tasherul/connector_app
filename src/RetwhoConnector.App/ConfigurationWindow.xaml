<Window x:Class="RetwhoConnector.App.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection &amp; License Configuration"
        Width="540"
        SizeToContent="Height"
        MinHeight="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Connection and license configuration">
    <Border Margin="20"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="28">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Connection &amp; License Configuration"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Settings are tested before encrypted storage is changed."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,22" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="License" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="License key"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <PasswordBox x:Name="LicenseKeyBox"
                         AutomationProperties.Name="License key"
                         PasswordChanged="LicenseKeyBox_OnPasswordChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Local POS host"
                       Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="HTTPS origin"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBox Text="{Binding PosBaseUrl,
                                   UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Local POS HTTPS origin"
                     ToolTip="For example: https://10.1.10.250" />
            <TextBlock Text="Username"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBox Text="{Binding PosUsername,
                                   UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="POS username" />
            <TextBlock Text="Password"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <PasswordBox x:Name="PosPasswordBox"
                         AutomationProperties.Name="POS password"
                         PasswordChanged="PosPasswordBox_OnPasswordChanged" />
            <CheckBox Content="Connect automatically on startup"
                      IsChecked="{Binding AutoConnect}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,5,0,10" />
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Clear Saved Settings"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource DangerButtonStyle}" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        IsCancel="True" />
                <Button Content="Save &amp; Test Connection"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
