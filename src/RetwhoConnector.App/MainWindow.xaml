<Window x:Class="RetwhoConnector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RetwhoConnector.App.Converters"
        Title="Retwho Connector"
        Width="980"
        Height="820"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Retwho Connector" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Secure local POS to cloud bridge"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="16" Margin="0,4,0,20" />
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Configuration" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="License key" />
                        <PasswordBox x:Name="LicenseKeyBox"
                                     AutomationProperties.Name="License key"
                                     PasswordChanged="LicenseKeyBox_OnPasswordChanged" />
                        <TextBlock Text="Local POS HTTPS URL" />
                        <TextBox Text="{Binding PosBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Local POS HTTPS URL" />
                        <TextBlock Text="POS username" />
                        <TextBox Text="{Binding PosUsername, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="POS username" />
                        <TextBlock Text="POS password" />
                        <PasswordBox x:Name="PosPasswordBox"
                                     AutomationProperties.Name="POS password"
                                     PasswordChanged="PosPasswordBox_OnPasswordChanged" />
                        <CheckBox Content="Connect automatically on startup"
                                  IsChecked="{Binding AutoConnect}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  Margin="0,4,0,12" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Save &amp; Connect"
                                    Command="{Binding SaveAndConnectCommand}" />
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectCommand}" />
                            <Button Content="Test POS Login"
                                    Command="{Binding TestPosLoginCommand}" />
                            <Button Content="Trust POS Certificate"
                                    Command="{Binding TrustPosCertificateCommand}" />
                            <Button Content="Clear Saved Settings"
                                    Command="{Binding ClearSavedSettingsCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Status" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="POS configuration" />
                            <TextBlock Grid.Column="1" Text="{Binding PosConfigurationStatus}"
                                       Foreground="{Binding PosConfigurationStatus, Converter={StaticResource StatusBrush}}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="POS authentication" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PosAuthenticationStatus}"
                                       Foreground="{Binding PosAuthenticationStatus, Converter={StaticResource StatusBrush}}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Text="Bridge transport" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BridgeStatus}"
                                       Foreground="{Binding BridgeStatus, Converter={StaticResource StatusBrush}}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Text="Agent registration" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RegistrationStatus}"
                                       Foreground="{Binding RegistrationStatus, Converter={StaticResource StatusBrush}}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Text="Last command" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastCommandStatus}"
                                       Foreground="{Binding LastCommandStatus, Converter={StaticResource StatusBrush}}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="Last JSON result" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,20,0,8" />
                        <TextBox Text="{Binding LastJsonResult, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" FontFamily="Consolas"
                                 MinHeight="220" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Activity" Style="{StaticResource SectionHeaderStyle}" />
                    <ListBox ItemsSource="{Binding ActivityItems}"
                             Background="Transparent"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             BorderThickness="0"
                             MinHeight="120"
                             MaxHeight="220"
                             AutomationProperties.Name="Recent connector activity" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
