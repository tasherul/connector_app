<Window x:Class="RetwhoConnector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RetwhoConnector.App.Converters"
        xmlns:vm="clr-namespace:RetwhoConnector.App.ViewModels"
        Title="Hybrid Edge Connector Agent"
        Width="1120"
        Height="760"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Hybrid Edge Connector Agent dashboard">
    <Window.Resources>
        <conv:DashboardSignalToBrushConverter x:Key="DashboardSignalBrush" />
        <conv:LogCategoryToBrushConverter x:Key="LogCategoryBrush" />
        <conv:UppercaseTextConverter x:Key="UppercaseText" />
        <conv:WidthToStatusColumnCountConverter
            x:Key="WidthToStatusColumnCount" />
        <DataTemplate x:Key="StatusRailSegmentTemplate"
                      DataType="{x:Type vm:DashboardStatusItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28"
                        Height="28"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6"
                        VerticalAlignment="Top">
                    <Path x:Name="StatusIcon"
                          Width="16"
                          Height="16"
                          Fill="{DynamicResource InfoBrush}"
                          Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title, Converter={StaticResource UppercaseText}}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding Signal,
                                        Converter={StaticResource DashboardSignalBrush}}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Status}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               ToolTip="{Binding Description}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IconKey}"
                             Value="ConfigurationIconGeometry">
                    <Setter TargetName="StatusIcon"
                            Property="Data"
                            Value="{StaticResource ConfigurationIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}"
                             Value="CloudIconGeometry">
                    <Setter TargetName="StatusIcon"
                            Property="Data"
                            Value="{StaticResource CloudIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}"
                             Value="AgentIconGeometry">
                    <Setter TargetName="StatusIcon"
                            Property="Data"
                            Value="{StaticResource AgentIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKey}"
                             Value="LogsIconGeometry">
                    <Setter TargetName="StatusIcon"
                            Property="Data"
                            Value="{StaticResource LogsIconGeometry}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="ConfigurationRailSegmentStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Columns,
                              RelativeSource={RelativeSource AncestorType={x:Type UniformGrid}}}"
                             Value="2">
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServerRailSegmentStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Columns,
                              RelativeSource={RelativeSource AncestorType={x:Type UniformGrid}}}"
                             Value="2">
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgentRailSegmentStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Columns,
                              RelativeSource={RelativeSource AncestorType={x:Type UniformGrid}}}"
                             Value="2">
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogsRailSegmentStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Hybrid Edge Connector Agent"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Secure local POS to Retwho cloud bridge"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="15"
                           Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Grid.Row="1"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Connector command actions">
                <Button Content="Settings"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource SettingsButtonStyle}"
                        AutomationProperties.Name="Open connection settings" />
                <Button Content="{Binding ConnectionActionText}"
                        Command="{Binding ToggleConnectionCommand}"
                        Style="{StaticResource ConnectionButtonStyle}"
                        AutomationProperties.Name="Connect or disconnect" />
                <Button Content="Open Logs Folder"
                        Command="{Binding OpenLogsFolderCommand}"
                        Style="{StaticResource LogsButtonStyle}"
                        AutomationProperties.Name="Open logs folder" />
                <Button Content="Exit"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        AutomationProperties.Name="Exit application" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                x:Name="StatusRail"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,22,0,16"
                Padding="4"
                AutomationProperties.Name="Connector status rail container">
            <UniformGrid x:Name="StatusRailGrid"
                         Columns="{Binding ActualWidth,
                                          RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                          Converter={StaticResource WidthToStatusColumnCount}}">
                <Border Style="{StaticResource ConfigurationRailSegmentStyle}"
                        Padding="12">
                    <ContentControl Content="{Binding ConfigurationIndicator}"
                                    ContentTemplate="{StaticResource StatusRailSegmentTemplate}"
                                    AutomationProperties.Name="Configuration status indicator" />
                </Border>
                <Border Style="{StaticResource ServerRailSegmentStyle}"
                        Padding="12">
                    <ContentControl Content="{Binding ServerIndicator}"
                                    ContentTemplate="{StaticResource StatusRailSegmentTemplate}"
                                    AutomationProperties.Name="Cloud server status indicator" />
                </Border>
                <Border Style="{StaticResource AgentRailSegmentStyle}"
                        Padding="12">
                    <ContentControl Content="{Binding AgentIndicator}"
                                    ContentTemplate="{StaticResource StatusRailSegmentTemplate}"
                                    AutomationProperties.Name="Agent status indicator" />
                </Border>
                <Border Style="{StaticResource LogsRailSegmentStyle}"
                        Padding="12">
                    <ContentControl Content="{Binding LoggingIndicator}"
                                    ContentTemplate="{StaticResource StatusRailSegmentTemplate}"
                                    AutomationProperties.Name="Logging status indicator" />
                </Border>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9"
                         Height="9"
                         Fill="{Binding AgentIndicator.Signal,
                             Converter={StaticResource DashboardSignalBrush}}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding BannerMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource TerminalBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        Padding="16,11"
                        CornerRadius="9,9,0,0">
                    <Grid>
                        <TextBlock Text="LIVE ACTIVITY"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="sanitized diagnostics"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ActivityEntries}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Live sanitized agent activity">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Category,
                                                Converter={StaticResource LogCategoryBrush}}"
                                    Padding="14,7"
                                    Margin="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LocalTime}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CategoryText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Details}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
